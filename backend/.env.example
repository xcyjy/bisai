# 复制为 .env 并按需填写。不填 Key 则自动用「离线规则引擎」，demo 仍可跑通。

# ===== LLM =====
# Anthropic API Key（用 Claude 做高质量转换时需要）
ANTHROPIC_API_KEY=
# 使用的模型，默认 claude-opus-4-8
SCRIPT_MODEL=claude-opus-4-8
# 强制离线模式（true=不调用 LLM，纯规则转换，适合无网/无 key 演示）
FORCE_OFFLINE=false

# ===== 数据库 =====
# 本地默认 SQLite（留空即用）；部署到云改为 PostgreSQL：
# DATABASE_URL=postgresql+psycopg://novel:novel@db:5432/novel
DATABASE_URL=sqlite:///./local.db

# ===== 认证 JWT =====
# ⚠️ 生产务必改成随机长字符串：python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===== CORS（逗号分隔的前端来源）=====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
