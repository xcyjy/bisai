# 云端部署用环境变量。复制为 .env 后填写，再执行：
#   docker compose -f docker-compose.cloud.yml --env-file .env up -d --build

# 数据库
POSTGRES_USER=novel
POSTGRES_PASSWORD=改成强密码
POSTGRES_DB=novel

# JWT（务必随机：python -c "import secrets;print(secrets.token_hex(32))"）
JWT_SECRET=改成随机长字符串
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 允许的前端域名（你的实际域名）
CORS_ORIGINS=https://your-domain.com

# LLM：留空 + FORCE_OFFLINE=true 则用离线引擎；要用 Claude 则填 Key 并设 false
FORCE_OFFLINE=true
ANTHROPIC_API_KEY=
SCRIPT_MODEL=claude-opus-4-8
